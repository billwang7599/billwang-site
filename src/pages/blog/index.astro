---
// /blog — the full post index, newest-first, with a tag filter. Posts come
// from the `blog` collection; each row carries its tags + reading time, and the
// filter below the header narrows the list client-side (the list still renders
// complete without JS). The hero holds the ASCII business card.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime } from '../../lib/reading';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Every tag in use, alphabetised, for the filter row.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// Dates are written as plain YYYY-MM-DD and parse as UTC midnight; format them
// in UTC too so the build machine's timezone can't shift them a day.
const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const since = posts.length ? fmtDate(posts[posts.length - 1].data.pubDate).slice(0, 7) : '';

// Posts are numbered oldest-first, so a post keeps its number as more arrive
// and as the filter hides its neighbours.
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Blog — Bill Wang"
  description="Posts by Bill Wang — dev logs, networking, homelab and more."
  canonical="https://billwang.dev/blog"
  current="blog"
  wide
>
  <header class="page-header">
    <div class="intro">
      <h1 class="display">Blog</h1>
      <p class="lede display">Dev logs, notes, and things worth keeping.</p>
      <p class="count mono">
        {posts.length} entries{since && ` · since ${since}`}
        <span class="hint"> · drag the card</span>
      </p>
    </div>
    <button class="ascii-card" type="button" aria-label="Spin the ASCII business card">
      <pre aria-hidden="true"></pre>
    </button>
  </header>

  {
    tags.length > 0 && (
      <div class="filters mono" role="group" aria-label="Filter by tag">
        <span class="filters-label">filter:</span>
        <button class="opt" data-tag="*" type="button" aria-pressed="true">
          <span class="mark">(•)</span> all
        </button>
        {tags.map((t) => (
          <button class="opt" data-tag={t} type="button" aria-pressed="false">
            <span class="mark">( )</span> {t}
          </button>
        ))}
      </div>
    )
  }

  {
    posts.length === 0 ? (
      <p class="empty">Coming soon.</p>
    ) : (
      <ol class="entries" id="post-list">
        {posts.map((post, i) => (
          <li data-tags={post.data.tags.join(' ')} style={`--i:${i}`}>
            <a class="row" href={`/blog/${post.id}`} aria-label={post.data.title}>
              <span class="num" aria-hidden="true">
                {pad(posts.length - i)}
              </span>
              <span>
                <span class="title" aria-hidden="true" data-text={post.data.title}>
                  {post.data.title}
                </span>
                <span class="trail" aria-hidden="true">
                  <span> ──────────────────&gt;</span>
                </span>
                <span class="blurb">{post.data.description}</span>
              </span>
              <span class="meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {fmtDate(post.data.pubDate)}
                </time>
                <br />
                {post.data.tags[0] && `${post.data.tags[0]} · `}
                {readingTime(post.body ?? '')} min
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <p class="no-match empty" hidden>nothing tagged that — yet.</p>

  <script>
    import { mountAsciiCard } from '../../scripts/ascii-card';

    const card = document.querySelector<HTMLButtonElement>('.ascii-card');
    if (card) mountAsciiCard(card, card.querySelector('pre')!);

    // Progressive enhancement: filter the rendered list by tag, in place.
    const opts = document.querySelectorAll<HTMLButtonElement>('.opt');
    const items = document.querySelectorAll<HTMLLIElement>('#post-list li');
    const noMatch = document.querySelector<HTMLParagraphElement>('.no-match');

    for (const opt of opts) {
      opt.addEventListener('click', () => {
        const tag = opt.dataset.tag!;
        for (const o of opts) {
          const on = o === opt;
          o.setAttribute('aria-pressed', String(on));
          o.querySelector('.mark')!.textContent = on ? '(•)' : '( )';
        }

        let shown = 0;
        for (const li of items) {
          const tags = (li.dataset.tags ?? '').split(' ');
          const match = tag === '*' || tags.includes(tag);
          li.hidden = !match;
          if (match) shown++;
        }
        if (noMatch) noMatch.hidden = shown !== 0;
      });
    }

    // Hovering a row scrambles its title into glyphs, then resolves it left to
    // right. The link's accessible name comes from aria-label, so screen
    // readers never hear the noise.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const GLYPHS = '#/\\<>_01:+=*%';
      for (const row of document.querySelectorAll<HTMLAnchorElement>('#post-list .row')) {
        const title = row.querySelector<HTMLElement>('.title')!;
        const text = title.dataset.text!;
        let timer: number | undefined;

        const scramble = () => {
          clearInterval(timer);
          let shown = 0;
          timer = window.setInterval(() => {
            shown += 2;
            if (shown >= text.length) {
              clearInterval(timer);
              title.textContent = text;
              return;
            }
            title.textContent = [...text]
              .map((c, k) => (k < shown || c === ' ' ? c : GLYPHS[(k * 7 + shown * 3) % GLYPHS.length]))
              .join('');
          }, 22);
        };
        row.addEventListener('pointerenter', scramble);
        row.addEventListener('focus', scramble);
      }
    }
  </script>

  <style>
    .page-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.5rem 2.5rem;
      margin-bottom: clamp(2.5rem, 7vw, 4.5rem);
    }
    .intro {
      flex: 1 1 20rem;
      min-width: 0;
    }
    h1 {
      font-weight: 300;
      font-size: clamp(6rem, 18vw, 12.5rem);
      line-height: 0.8;
      letter-spacing: -0.01em;
    }
    .lede {
      margin-top: 1.4rem;
      font-weight: 500;
      font-size: clamp(1.5rem, 3.4vw, 1.9rem);
      line-height: 1.05;
      max-width: 26rem;
    }
    .count {
      margin-top: 1rem;
      font-size: 0.8rem;
      color: var(--ink-soft);
    }
    .hint {
      color: var(--accent);
    }

    .ascii-card {
      all: unset;
      flex: 1 1 32rem;
      min-width: 0;
      display: block;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      /* Vertical swipes still scroll the page on touch; sideways ones spin. */
      touch-action: pan-y;
    }
    .ascii-card:active {
      cursor: grabbing;
    }
    .ascii-card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
    }
    .ascii-card pre {
      margin: 0;
      font-family: var(--mono);
      font-size: 10px; /* refit to the width by the script */
      line-height: 1.1;
      color: var(--ink);
      white-space: pre;
      overflow: hidden;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 1rem;
      margin-bottom: 0.75rem;
      font-size: 0.85rem;
    }
    .filters-label {
      color: var(--ink-soft);
    }
    .opt {
      font: inherit;
      color: var(--ink-soft);
      background: none;
      border: 0;
      padding: 0 0.25rem;
      min-height: 44px;
      cursor: pointer;
      transition: color 0.15s ease;
    }
    .opt:hover {
      color: var(--accent);
    }
    .opt[aria-pressed='true'] {
      color: var(--ink);
    }
    .no-match {
      padding: 1.35rem 0;
    }
  </style>
</Base>
