---
// /blog — the full post index, newest-first, with a tag filter. Posts come
// from the `blog` collection; each row carries its tags + reading time, and the
// filter below the header narrows the list client-side (the list still renders
// complete without JS). The header holds a small ASCII business card.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { readingTime } from '../../lib/reading';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Every tag in use, alphabetised, for the filter row.
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// Dates are written as plain YYYY-MM-DD and parse as UTC midnight; format them
// in UTC too so the build machine's timezone can't shift them a day.
const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');
const since = posts.length ? fmtDate(posts[posts.length - 1].data.pubDate).slice(0, 7) : '';
---

<Base
  title="Blog — Bill Wang"
  description="Posts by Bill Wang — dev logs, networking, homelab and more."
  canonical="https://billwang.dev/blog"
  current="blog"
>
  <header class="page-header">
    <div class="intro">
      <h1>~/blog</h1>
      <p class="lede">Dev logs, notes, and things worth keeping.</p>
      <p class="count">{posts.length} entries{since && ` · since ${since}`}</p>
    </div>
    <button
      class="ascii-card"
      type="button"
      title="drag me"
      aria-label="Spin the ASCII business card"
    >
      <pre aria-hidden="true"></pre>
    </button>
  </header>

  {
    tags.length > 0 && (
      <div class="filters" role="group" aria-label="Filter by tag">
        <button class="opt" data-tag="*" type="button" aria-pressed="true">
          <span class="mark">(•)</span> all
        </button>
        {tags.map((t) => (
          <button class="opt" data-tag={t} type="button" aria-pressed="false">
            <span class="mark">( )</span> {t}
          </button>
        ))}
      </div>
    )
  }

  {
    posts.length === 0 ? (
      <p class="empty">Coming soon.</p>
    ) : (
      <ol class="entries" id="post-list">
        {posts.map((post, i) => (
          <li data-tags={post.data.tags.join(' ')} style={`--i:${i}`}>
            <a class="row" href={`/blog/${post.id}`} aria-label={post.data.title}>
              <span class="line">
                <span class="title" aria-hidden="true" data-text={post.data.title.toLowerCase()}>
                  {post.data.title}
                </span>
                <span class="leader" aria-hidden="true" />
                <time class="date" datetime={post.data.pubDate.toISOString()}>
                  {fmtDate(post.data.pubDate)}
                </time>
              </span>
              <span class="blurb">
                {post.data.description}
                <span class="mins"> · {readingTime(post.body ?? '')} min</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <p class="no-match empty" hidden>nothing tagged that — yet.</p>

  <script>
    import { mountAsciiCard } from '../../scripts/ascii-card';

    const card = document.querySelector<HTMLButtonElement>('.ascii-card');
    if (card) mountAsciiCard(card, card.querySelector('pre')!);

    // Progressive enhancement: filter the rendered list by tag, in place.
    const opts = document.querySelectorAll<HTMLButtonElement>('.opt');
    const items = document.querySelectorAll<HTMLLIElement>('#post-list li');
    const noMatch = document.querySelector<HTMLParagraphElement>('.no-match');

    for (const opt of opts) {
      opt.addEventListener('click', () => {
        const tag = opt.dataset.tag!;
        for (const o of opts) {
          const on = o === opt;
          o.setAttribute('aria-pressed', String(on));
          o.querySelector('.mark')!.textContent = on ? '(•)' : '( )';
        }

        let shown = 0;
        for (const li of items) {
          const tags = (li.dataset.tags ?? '').split(' ');
          const match = tag === '*' || tags.includes(tag);
          li.hidden = !match;
          if (match) shown++;
        }
        if (noMatch) noMatch.hidden = shown !== 0;
      });
    }

    // Hovering a row flickers its title through a few glyphs, then resolves it
    // left to right. The link's accessible name comes from aria-label, so
    // screen readers never hear the noise.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const GLYPHS = '#/\\<>_01:+=*%';
      for (const row of document.querySelectorAll<HTMLAnchorElement>('#post-list .row')) {
        const title = row.querySelector<HTMLElement>('.title')!;
        const text = title.dataset.text!;
        let timer: number | undefined;

        const scramble = () => {
          clearInterval(timer);
          let shown = 0;
          timer = window.setInterval(() => {
            shown += 3;
            if (shown >= text.length) {
              clearInterval(timer);
              title.textContent = text;
              return;
            }
            title.textContent = [...text]
              .map((c, k) => (k < shown || c === ' ' ? c : GLYPHS[(k * 7 + shown * 3) % GLYPHS.length]))
              .join('');
          }, 16);
        };
        row.addEventListener('pointerenter', scramble);
        row.addEventListener('focus', scramble);
      }
    }
  </script>

  <style>
    .page-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem 2rem;
      margin: 0 0 clamp(1.5rem, 5vw, 2.5rem);
    }
    .intro {
      flex: 1 1 16rem;
      min-width: 0;
    }
    h1 {
      font-size: 0.95rem;
      font-weight: 600;
    }
    .lede {
      margin-top: 0.6rem;
      font-size: 0.8rem;
      line-height: 1.6;
      color: var(--ink-soft);
    }
    .count {
      margin-top: 0.25rem;
      font-size: 0.75rem;
      color: var(--faint);
    }

    .ascii-card {
      all: unset;
      flex: 0 0 auto;
      display: block;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
      /* Vertical swipes still scroll the page on touch; sideways ones spin. */
      touch-action: pan-y;
    }
    .ascii-card:active {
      cursor: grabbing;
    }
    .ascii-card:focus-visible {
      outline: 1px solid var(--accent);
      outline-offset: 4px;
    }
    .ascii-card pre {
      /* The grid keeps spare rows so a tilted card never clips; at rest those
         are blank, so let them overhang rather than push the layout apart. */
      margin: -8em 0;
      font-family: var(--mono);
      font-size: 4.3px;
      line-height: 1.1;
      color: #a3a4aa;
      white-space: pre;
    }

    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 1rem;
      font-size: 0.8rem;
    }
    .opt {
      font: inherit;
      color: var(--ink-soft);
      background: none;
      border: 0;
      padding: 0;
      min-height: 44px;
      cursor: pointer;
      transition: color 0.15s ease;
    }
    .opt:hover {
      color: var(--ink);
    }
    .opt[aria-pressed='true'] {
      color: var(--accent);
    }
    .mins {
      color: var(--faint);
    }
    .no-match {
      padding: 1.2rem 0;
    }
  </style>
</Base>
