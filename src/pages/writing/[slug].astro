---
// /writing/[slug] — one page per blog post. getStaticPaths enumerates every
// non-draft post and, for each, computes reading time from the raw Markdown.
import { getCollection, getEntry, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { readingTime } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      minutes: readingTime(post.body ?? ''),
    },
  }));
}

const { post, minutes } = Astro.props;
const { Content } = await render(post);

// If this post is tied to a project, resolve it for the "part of" link.
const projectRef = post.data.project ? await getEntry(post.data.project) : undefined;
const project = projectRef
  ? { slug: projectRef.id, title: projectRef.data.title }
  : undefined;
---

<Post
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  slug={post.id}
  minutes={minutes}
  project={project}
>
  <Content />
</Post>
