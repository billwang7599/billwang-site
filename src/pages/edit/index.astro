      .panel {
        background: var(--panel);
        backdrop-filter: blur(8px);
        border: 1px solid var(--hair);
        border-radius: 1rem;
        padding: 1.1rem 1.15rem;
        box-shadow: 0 12px 40px rgba(21, 22, 26, 0.06);
      }

      .panel-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.9rem;
      }

      .panel-title {
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ink-soft);
        font-weight: 500;
        margin-bottom: 0.9rem;
      }

      .panel-head .panel-title { margin-bottom: 0; }

      .body-stats {
        font-size: 0.75rem;
        font-style: italic;
        color: var(--ink-soft);
        font-variant-numeric: tabular-nums;
      }

      .field-stack,
      .field-row {
        display: flex;
        gap: 0.85rem;
        margin-bottom: 0.85rem;
      }

      .field-stack { flex-direction: column; }
      .field-row { flex-wrap: wrap; align-items: flex-end; }
      .field-row:last-child,
      .field-stack:last-child { margin-bottom: 0; }

      label {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
      }

      label.grow { flex: 1 1 12rem; }

      label > span {
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      label.toggle {
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.55rem;
        flex: 0 0 auto;
        cursor: pointer;
      }

      label.toggle > span {
        text-transform: none;
        letter-spacing: 0.02em;
        font-size: 0.95rem;
        color: var(--ink);
      }

      input, select, textarea {
        font: inherit;
        font-size: 1rem;
        color: var(--ink);
        border: 1px solid var(--hair-strong);
        border-radius: 0.55rem;
        padding: 0.55rem 0.7rem;
        background: rgba(255, 255, 255, 0.82);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: rgba(21, 22, 26, 0.4);
        box-shadow: 0 0 0 3px rgba(21, 22, 26, 0.07);
      }

      label.toggle input {
        width: 1rem;
        height: 1rem;
        padding: 0;
        accent-color: var(--ink);
        cursor: pointer;
      }

      .body-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      textarea {
        flex: 1;
        min-height: calc(100vh - 24rem);
        resize: vertical;
        line-height: 1.6;
        font-family: ui-monospace, 'SF Mono', Menlo, monospace;
        font-size: 0.88rem;
      }

      /* Arrival: the chrome settles, then the panels rise into it. One
         orchestrated load rather than a scatter of separate fades. */
      @media (prefers-reduced-motion: no-preference) {
        .top { animation: settle 0.5s cubic-bezier(0.2, 0.65, 0.2, 1) both; }
        aside { animation: fade 0.6s ease 0.06s both; }
        .file-bar { animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.1s both; }
        .fields:not([hidden]) { animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.14s both; }
        .body-panel { animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.2s both; }
      }

      @keyframes rise {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
      }
      @keyframes settle {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: none; }
      }
      @keyframes fade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @media (max-width: 900px) {
        .top {
          grid-template-columns: 1fr auto;
          row-gap: 0.75rem;
        }

        .tabs { grid-column: 1; grid-row: 2; }
        .actions { grid-column: 2; grid-row: 2; }

        .layout { grid-template-columns: 1fr; }

        aside {
          max-height: 14rem;
          border-right: none;
          border-bottom: 1px solid var(--hair);
        }

        textarea { min-height: 20rem; }
      }

      /* ---- Confirm dialog -------------------------------------------------- */
      dialog.ask {
        border: none;
        padding: 0;
        background: transparent;
        color: var(--ink);
        max-width: min(26rem, calc(100vw - 2rem));
      }

      dialog.ask::backdrop {
        background: rgba(21, 22, 26, 0.36);
        backdrop-filter: blur(3px);
      }

      dialog.ask form {
        max-width: none;
        gap: 0;
        background: var(--panel-solid);
        border: 1px solid var(--hair-strong);
        border-radius: 1.1rem;
        padding: 1.5rem 1.6rem 1.3rem;
        box-shadow: 0 24px 70px rgba(21, 22, 26, 0.3);
      }

      dialog.ask h2 {
        font-size: 1.4rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        line-height: 1.2;
      }

      dialog.ask p {
        margin-top: 0.6rem;
        font-size: 1rem;
        line-height: 1.5;
        color: var(--ink-soft);
      }

      dialog.ask menu {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1.4rem;
        list-style: none;
      }

      @media (prefers-reduced-motion: no-preference) {
        dialog.ask[open] { animation: ask-in 0.2s cubic-bezier(0.2, 0.65, 0.2, 1); }
        dialog.ask[open]::backdrop { animation: fade 0.2s ease; }
      }

      @keyframes ask-in {
        from { opacity: 0; transform: translateY(8px) scale(0.98); }
        to { opacity: 1; transform: none; }
      }

      /* ---- Image popup --------------------------------------------------- */
      .modal[hidden] { display: none; }

      .modal {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: grid;
        place-items: center;
        padding: 1.5rem;
      }

      .modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(21, 22, 26, 0.34);
        backdrop-filter: blur(3px);
      }

      .modal-card {
        position: relative;
        width: min(30rem, 100%);
        background: var(--panel-solid);
        border: 1px solid var(--hair-strong);
        border-radius: 1.1rem;
        padding: 1.5rem;
        box-shadow: 0 24px 70px rgba(21, 22, 26, 0.28);
      }

      .modal-close {
        position: absolute;
        top: 0.55rem;
        right: 0.55rem;
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: grid;
        place-items: center;
        font-size: 1.2rem;
        line-height: 1;
        letter-spacing: 0;
        border: 1px solid transparent;
        border-radius: 999px;
        background: transparent;
        color: var(--ink-soft);
      }

      .modal-close:hover { background: rgba(21, 22, 26, 0.06); color: var(--ink); }

      .dropzone {
        display: grid;
        place-items: center;
        text-align: center;
        min-height: 12rem;
        border: 2px dashed var(--hair-strong);
        border-radius: 0.9rem;
        background: rgba(255, 255, 255, 0.5);
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease;
      }

      .dropzone:hover { border-color: rgba(21, 22, 26, 0.4); }
      .dropzone:focus-visible { outline: none; border-color: var(--ink); }

      .dropzone.is-over {
        border-color: var(--ink);
        background: rgba(21, 22, 26, 0.05);
      }

      .dropzone-title { font-size: 1.15rem; font-weight: 500; }

      .dropzone-sub {
        margin-top: 0.35rem;
        font-size: 0.9rem;
        font-style: italic;
        color: var(--ink-soft);
      }

      .modal-status {
        margin-top: 0.9rem;
        min-height: 1.2rem;
        text-align: center;
        font-size: 0.85rem;
        font-style: italic;
        color: var(--ink-soft);
      }

      .modal-status[data-kind='err'] { color: var(--danger); font-style: normal; }
    </style>
  </body>
</html>
