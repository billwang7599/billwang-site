---
// /edit — dev-only content editor. Writes to src/content/ via Vite middleware.
// Stripped from dist after build.
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="noindex" />
    <title>Content editor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <div class="brand">
        <a class="site-name" href="/" id="home-link">bill wang</a>
        <span class="badge">/ editor</span>
      </div>
      <div class="actions">
        <span id="status" class="status" role="status" aria-live="polite"></span>
        <button id="save-btn" type="button" class="primary">
          save
          <kbd>&#8984;S</kbd>
        </button>
      </div>
    </header>

    <p id="api-banner" class="api-banner" hidden>
      Editor API unavailable — stop the dev server and run <code>npm run dev</code> again.
    </p>

    <div class="layout">
      <aside>
        <div class="sidebar-head">
          <p class="sidebar-label">
            <span>~/blog</span>
            <span id="item-count" class="count"></span>
          </p>
          <button id="new-btn" type="button" class="ghost tiny">+ new</button>
        </div>
        <input id="search" type="search" placeholder="filter&hellip; (⌘K)" aria-label="Filter list" />
        <div id="item-list" class="item-list"></div>
      </aside>

      <main>
        <form id="editor" autocomplete="off" novalidate>
          <!-- The file this form is bound to, plus the two actions that act on
               the file rather than the draft in front of you. Kept away from
               Save so Delete is never a mis-click's distance from it. -->
          <div class="file-bar">
            <span id="editor-target" class="editor-target"></span>
            <span class="file-bar-actions">
              <a
                id="preview-link"
                class="ghost tiny"
                href="#"
                target="_blank"
                rel="noopener"
                hidden>preview &#8599;</a
              >
              <button id="delete-btn" type="button" class="danger tiny" disabled>delete</button>
            </span>
          </div>
          <!-- An ASCII progress bar while a save is in flight, then a little
               celebration. Decorative: the status line announces the result. -->
          <p id="save-line" class="save-line" aria-hidden="true"></p>

          <!-- Post fields -->
          <div id="post-fields" class="fields">
            <section class="panel">
              <h2 class="panel-title">Details</h2>
              <div class="field-stack">
                <label>
                  <span>Title</span>
                  <input id="post-title" type="text" />
                </label>
                <label>
                  <span>Description</span>
                  <input id="post-description" type="text" />
                </label>
              </div>
              <div class="field-row">
                <label>
                  <span>Published</span>
                  <input id="post-pubDate" type="date" />
                </label>
                <label>
                  <span>Updated</span>
                  <input id="post-updatedDate" type="date" />
                </label>
              </div>
              <div class="field-row">
                <label class="grow">
                  <span>Tags</span>
                  <input id="post-tags" type="text" placeholder="devlog, homelab" />
                </label>
                <label class="toggle">
                  <input id="post-draft" type="checkbox" />
                  <span>Draft</span>
                </label>
              </div>
            </section>
          </div>

          <section class="panel body-panel">
            <div class="panel-head">
              <h2 class="panel-title">Body</h2>
              <span id="body-stats" class="body-stats"></span>
            </div>
            <textarea
              id="body"
              spellcheck="false"
              placeholder="Markdown… — paste an image, or type /image to pick one"></textarea>
            <input id="file-picker" type="file" accept="image/*" multiple hidden />
          </section>
        </form>
      </main>
    </div>

    <!-- Replaces window.confirm() everywhere the editor can intercept. Native
         <dialog> so focus trapping, Esc-to-dismiss and inertness come free. -->
    <dialog id="confirm-dialog" class="ask" aria-labelledby="confirm-title">
      <form method="dialog">
        <h2 id="confirm-title"></h2>
        <p id="confirm-message"></p>
        <menu>
          <button value="cancel" class="ghost" id="confirm-cancel">Cancel</button>
          <button value="ok" class="primary" id="confirm-ok">Continue</button>
        </menu>
      </form>
    </dialog>

    <div id="image-modal" class="modal" hidden>
      <div class="modal-backdrop" data-close></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-label="Add image">
        <button type="button" class="modal-close" data-close aria-label="Close">×</button>
        <div
          id="dropzone"
          class="dropzone"
          role="button"
          tabindex="0"
          aria-label="Drop an image, or click to browse"
        >
          <div>
            <p class="dropzone-title">Drop an image here</p>
            <p class="dropzone-sub">or click to browse</p>
          </div>
        </div>
        <p id="modal-status" class="modal-status" aria-live="polite"></p>
      </div>
    </div>

    <script>
      // The editor is served at /edit (blog host) and /blog/edit (apex); the API
      // sits beside whichever one this page was loaded from.
      const API = location.pathname.startsWith('/blog/edit') ? '/blog/edit/api' : '/edit/api';
      const API_FALLBACK = '/blog/api';
      let currentId = null;
      let dirty = false;
      // Serialised form state as of the last load/save. Dirty is a comparison
      // against this rather than a "something was typed" flag, so typing and
      // then undoing leaves you clean and you never get nagged over nothing.
      let baseline = '';
      let items = [];

      const els = {
        status: document.getElementById('status'),
        banner: document.getElementById('api-banner'),
        target: document.getElementById('editor-target'),
        list: document.getElementById('item-list'),
        count: document.getElementById('item-count'),
        search: document.getElementById('search'),
        postFields: document.getElementById('post-fields'),
        body: document.getElementById('body'),
        bodyStats: document.getElementById('body-stats'),
        preview: document.getElementById('preview-link'),
        save: document.getElementById('save-btn'),
        del: document.getElementById('delete-btn'),
        newBtn: document.getElementById('new-btn'),
        homeLink: document.getElementById('home-link'),
        post: {
          title: document.getElementById('post-title'),
          description: document.getElementById('post-description'),
          pubDate: document.getElementById('post-pubDate'),
          updatedDate: document.getElementById('post-updatedDate'),
          tags: document.getElementById('post-tags'),
          draft: document.getElementById('post-draft'),
        },
      };

      // ---- Confirm dialog -------------------------------------------------
      const askDialog = document.getElementById('confirm-dialog');
      const askTitle = document.getElementById('confirm-title');
      const askMessage = document.getElementById('confirm-message');
      const askOk = document.getElementById('confirm-ok');

      /** Styled stand-in for confirm(). Resolves true only on the OK button —
       *  Esc, the Cancel button and a backdrop dismiss all resolve false. */
      function ask({ title, message, ok = 'Continue', tone = '' }) {
        askTitle.textContent = title;
        askMessage.textContent = message;
        askOk.textContent = ok;
        askOk.className = tone === 'danger' ? 'danger solid' : 'primary';
        askDialog.returnValue = '';
        askDialog.showModal();
        return new Promise((resolve) => {
          askDialog.addEventListener(
            'close',
            () => resolve(askDialog.returnValue === 'ok'),
            { once: true },
          );
        });
      }

      /** Gate for anything that would throw away the current draft. */
      function confirmDiscard() {
        if (!dirty) return Promise.resolve(true);
        return ask({
          title: 'Leave without saving?',
          message: 'This draft has changes that haven’t been written to disk yet.',
          ok: 'Discard changes',
          tone: 'danger',
        });
      }

      // Clicking the backdrop of a <dialog> targets the dialog itself.
      askDialog.addEventListener('click', (e) => {
        if (e.target === askDialog) askDialog.close('cancel');
      });

      // ---- Status ---------------------------------------------------------
      let statusTimer;
      function setStatus(text, kind = '') {
        els.status.textContent = text;
        els.status.dataset.kind = kind;
        els.status.classList.toggle('is-on', Boolean(text));
        clearTimeout(statusTimer);
        // Errors stay until something replaces them; everything else is a
        // confirmation you only need to catch out of the corner of an eye.
        if (text && kind !== 'err') {
          statusTimer = window.setTimeout(() => {
            els.status.classList.remove('is-on');
          }, 2600);
        }
      }

      function setTarget(text = '') {
        els.target.textContent = text;
      }

      function itemLabel(id) {
        if (!id) return '';
        return `src/content/blog/${id}.md`;
      }

      /** On blog.billwang.dev posts sit at the root; elsewhere (dev) under /blog/. */
      function previewHref(id) {
        return location.hostname.startsWith('blog.') ? `/${id}` : `/blog/${id}`;
      }

      function today() {
        return new Date().toISOString().slice(0, 10);
      }

      // ---- Dirty tracking -------------------------------------------------
      function snapshot() {
        return JSON.stringify(postFormData());
      }

      function applyDirty(next) {
        if (dirty === next) return;
        dirty = next;
        els.save.classList.toggle('is-dirty', dirty);
        els.target.classList.toggle('is-dirty', dirty);
        document.title = dirty ? '• Content editor' : 'Content editor';
      }

      /** Re-derive dirty from the form. Called on every input. */
      function syncDirty() {
        applyDirty(snapshot() !== baseline);
      }

      /** Adopt the current form state as the new clean baseline. */
      function markClean(msg = '') {
        baseline = snapshot();
        applyDirty(false);
        if (msg) setStatus(msg, 'ok');
      }

      function updateBodyStats() {
        const text = els.body.value.trim();
        const words = text ? text.split(/\s+/).length : 0;
        els.bodyStats.textContent = words
          ? `${words.toLocaleString()} words · ${Math.max(1, Math.round(words / 200))} min`
          : '';
      }

      function setApiOk(ok) {
        els.banner.hidden = ok;
      }

      async function apiFetch(base, path, opts = {}) {
        const res = await fetch(`${base}${path}`, {
          headers: { 'Content-Type': 'application/json' },
          ...opts,
        });
        let data = null;
        try {
          data = await res.json();
        } catch {
          data = null;
        }
        if (!res.ok) {
          const msg =
            data && typeof data === 'object' && data.error
              ? data.error
              : res.statusText || 'Request failed';
          const err = new Error(msg);
          err.status = res.status;
          throw err;
        }
        return data;
      }

      async function api(path, opts = {}) {
        try {
          const data = await apiFetch(API, path, opts);
          setApiOk(true);
          return data;
        } catch (err) {
          if (err.status === 404) {
            try {
              const data = await apiFetch(API_FALLBACK, path, opts);
              setApiOk(true);
              return data;
            } catch {
              // fall through
            }
          }
          setApiOk(false);
          throw new Error('Editor API unavailable — restart npm run dev');
        }
      }

      function asArray(data) {
        return Array.isArray(data) ? data : [];
      }

      function normalizePostItem(item) {
        const id = String(item?.id ?? '');
        const fm = item?.frontmatter;
        if (fm && typeof fm === 'object') {
          return {
            id,
            broken: Boolean(item?.broken),
            frontmatter: {
              title: fm.title ?? id,
              description: fm.description ?? '',
              pubDate: fm.pubDate ?? '',
              updatedDate: fm.updatedDate,
              tags: Array.isArray(fm.tags) ? fm.tags : [],
              draft: Boolean(fm.draft),
            },
          };
        }
        return {
          id,
          broken: Boolean(item?.broken),
          frontmatter: {
            title: item?.title ?? id,
            description: '',
            pubDate: '',
            tags: [],
            draft: false,
          },
        };
      }

      function normalizePostRecord(record) {
        const item = normalizePostItem(record);
        return {
          id: item.id,
          broken: item.broken,
          frontmatter: item.frontmatter,
          body: typeof record?.body === 'string' ? record.body : '',
        };
      }

      function postFormData() {
        return {
          title: els.post.title.value.trim(),
          description: els.post.description.value.trim(),
          pubDate: els.post.pubDate.value,
          updatedDate: els.post.updatedDate.value || undefined,
          tags: els.post.tags.value,
          draft: els.post.draft.checked,
          body: els.body.value,
        };
      }

      function fillPost(record) {
        const { frontmatter: fm, body, id, broken } = normalizePostRecord(record);
        if (!id) {
          setStatus('Could not load post', 'err');
          return;
        }
        currentId = id;
        els.post.title.value = fm.title ?? '';
        els.post.description.value = fm.description ?? '';
        els.post.pubDate.value = fm.pubDate ?? today();
        els.post.updatedDate.value = fm.updatedDate ?? '';
        els.post.tags.value = (fm.tags ?? []).join(', ');
        els.post.draft.checked = Boolean(fm.draft);
        els.body.value = body;
        els.preview.hidden = false;
        els.preview.href = previewHref(id);
        els.del.disabled = false;
        setTarget(itemLabel(id));
        updateBodyStats();
        markClean(broken ? 'Loaded — parse issue, review & save' : 'Loaded');
      }

      function blankPost() {
        currentId = null;
        els.post.title.value = '';
        els.post.description.value = '';
        els.post.pubDate.value = today();
        els.post.updatedDate.value = '';
        els.post.tags.value = '';
        els.post.draft.checked = false;
        els.body.value = '';
        els.preview.hidden = true;
        els.del.disabled = true;
        setTarget('New post — save to create a file');
        updateBodyStats();
        markClean('New post');
      }

      function blankForm() {
        blankPost();
        syncUrl();
      }

      // ---- List -----------------------------------------------------------
      function renderList(activeId = currentId) {
        const q = els.search.value.trim().toLowerCase();
        const shown = q
          ? items.filter((it) => {
              const fm = it.frontmatter;
              const hay = [it.id, fm.title, fm.description, ...(fm.tags ?? [])]
                .join(' ')
                .toLowerCase();
              return hay.includes(q);
            })
          : items;

        els.count.textContent = q ? `${shown.length}/${items.length}` : String(items.length);
        els.list.replaceChildren();

        if (shown.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'empty-list';
          empty.textContent = items.length === 0
            ? 'No posts yet.'
            : 'Nothing matches that.';
          els.list.append(empty);
          return;
        }

        for (const item of shown) {
          if (!item.id) continue;
          const fm = item.frontmatter;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'item' +
            (item.id === activeId ? ' is-active' : '') +
            (item.broken ? ' is-broken' : '');

          const title = document.createElement('span');
          title.className = 'item-title';
          title.textContent = fm.title || item.id;

          // Second line: the date, then any flags. Titles here wrap to two or
          // three lines, so flags sit down here rather than trailing the title
          // where they'd get stranded mid-wrap.
          const meta = document.createElement('span');
          meta.className = 'item-meta';

          const when = document.createElement('span');
          when.textContent = fm.pubDate || 'No date';
          meta.append(when);

          // Draft status is invisible in the filename, so surface them
          // here — otherwise you have to open a file to learn it isn't live.
          if (fm.draft) {
            const flag = document.createElement('span');
            flag.className = 'flag flag-draft';
            flag.textContent = '[draft]';
            meta.append(flag);
          }

          btn.append(title, meta);
          btn.addEventListener('click', () => openItem(item.id));
          els.list.append(btn);
        }
      }

      async function loadList(activeId = currentId) {
        const raw = await api('/posts');
        items = asArray(raw).map(normalizePostItem);
        renderList(activeId);
        return items;
      }

      async function openItem(id) {
        if (!id) return;
        if (id === currentId && !dirty) return;
        if (!(await confirmDiscard())) return;
        try {
          const record = await api(`/posts/${encodeURIComponent(id)}`);
          fillPost(record);
          syncUrl();
          await loadList(id);
        } catch (err) {
          setStatus(err.message, 'err');
        }
      }

      // ---- Save progress line -------------------------------------------
      const saveLine = document.getElementById('save-line');
      let saveTimer;
      let saveRun = 0; // a newer save supersedes an older one's finish
      const BAR = 12;

      /** Run the ASCII bar most of the way until `done` is called, then finish it
       *  (or clear it on failure). A local save takes a few ms, so the bar
       *  always plays for a beat rather than flashing. */
      function startSaveBar() {
        clearInterval(saveTimer);
        const run = ++saveRun;
        let n = 0;
        const paint = () => {
          saveLine.textContent = `[${'#'.repeat(n)}${'.'.repeat(BAR - n)}]`;
        };
        const started = performance.now();
        paint();
        saveTimer = window.setInterval(() => {
          if (n < BAR - 1) n++;
          paint();
        }, 25);
        return (ok) => {
          const wait = Math.max(0, 450 - (performance.now() - started));
          window.setTimeout(() => {
            if (run !== saveRun) return;
            clearInterval(saveTimer);
            if (!ok) {
              saveLine.textContent = '';
              return;
            }
            n = BAR;
            paint();
            saveTimer = window.setTimeout(() => {
              saveLine.textContent = 'saved';
              saveTimer = window.setTimeout(() => (saveLine.textContent = ''), 2200);
            }, 160);
          }, wait);
        };
      }

      async function saveCurrent() {
        const data = postFormData();
        if (!data.title || !data.description) {
          setStatus('Title and description are required', 'err');
          return;
        }
        if (!data.pubDate) {
          setStatus('Published date is required', 'err');
          return;
        }

        const done = startSaveBar();
        try {
          const base = '/posts';
          if (currentId) {
            await api(`${base}/${encodeURIComponent(currentId)}`, {
              method: 'PUT',
              body: JSON.stringify(data),
            });
            setTarget(itemLabel(currentId));
            markClean('Saved');
          } else {
            const created = await api(base, {
              method: 'POST',
              body: JSON.stringify(data),
            });
            currentId = created.id;
            els.preview.hidden = false;
            els.preview.href = previewHref(created.id);
            els.del.disabled = false;
            setTarget(itemLabel(created.id));
            markClean('Created');
            syncUrl();
          }
          await loadList(currentId);
          done(true);
        } catch (err) {
          done(false);
          setStatus(err.message, 'err');
        }
      }

      async function deleteCurrent() {
        if (!currentId) return;
        const ok = await ask({
          title: 'Delete this post?',
          message: `${itemLabel(currentId)} will be removed from disk. This can’t be undone from the editor.`,
          ok: 'Delete',
          tone: 'danger',
        });
        if (!ok) return;

        try {
          await api(`/posts/${encodeURIComponent(currentId)}`, { method: 'DELETE' });
          blankForm();
          await loadList();
          setStatus('Deleted', 'ok');
        } catch (err) {
          setStatus(err.message, 'err');
        }
      }

      /** Mirror the open file into the query string. Makes a refresh land
       *  where you left off, and makes any editor state a linkable URL. */
      function syncUrl() {
        const params = new URLSearchParams();
        if (currentId) params.set('id', currentId);
        history.replaceState(null, '', `${location.pathname}?${params}`);
      }

      els.save.addEventListener('click', saveCurrent);
      els.del.addEventListener('click', deleteCurrent);
      els.newBtn.addEventListener('click', async () => {
        if (!(await confirmDiscard())) return;
        blankForm();
        renderList(null);
        els.post.title.focus();
      });
      els.search.addEventListener('input', () => renderList());
      els.search.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          els.search.value = '';
          renderList();
        }
      });

      // Leaving for the live site is a real navigation, so intercept it here
      // rather than letting the browser's blunt beforeunload prompt handle it.
      els.homeLink.addEventListener('click', async (e) => {
        if (!dirty) return;
        e.preventDefault();
        if (await confirmDiscard()) {
          applyDirty(false); // don't let beforeunload re-ask on the way out
          location.href = els.homeLink.href;
        }
      });

      // The catch-all: tab close, reload, back button, address bar. The browser
      // renders its own wording here and won't accept ours.
      window.addEventListener('beforeunload', (e) => {
        if (!dirty) return;
        e.preventDefault();
        e.returnValue = '';
      });

      const editorForm = document.getElementById('editor');
      editorForm.addEventListener('input', (e) => {
        syncDirty();
        if (e.target === els.body) updateBodyStats();
      });
      editorForm.addEventListener('submit', (e) => {
        e.preventDefault();
        saveCurrent();
      });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 's') {
          e.preventDefault();
          saveCurrent();
        }
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          els.search.focus();
          els.search.select();
        }
      });

      // ---- Image paste / drop -------------------------------------------
      // Upload an image blob to the dev API (which writes it beside the
      // posts' Markdown under a uuid name) and return its ./path.
      async function uploadImage(file) {
        const q = '/uploads';
        const bases = [API, API_FALLBACK];
        for (let i = 0; i < bases.length; i++) {
          const last = i === bases.length - 1;
          try {
            const res = await fetch(`${bases[i]}${q}`, {
              method: 'POST',
              headers: { 'Content-Type': file.type },
              body: file,
            });
            if (res.status === 404 && !last) continue; // stale server → try fallback
            const data = await res.json().catch(() => null);
            if (!res.ok) throw new Error(data?.error || 'Upload failed');
            setApiOk(true);
            return data.path;
          } catch (err) {
            if (last) {
              setApiOk(false);
              throw new Error(err?.message || 'Editor API unavailable — restart npm run dev');
            }
          }
        }
      }

      // Insert text at the caret, keeping the image on its own line.
      function insertAtCursor(textarea, text) {
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? start;
        const before = textarea.value.slice(0, start);
        const after = textarea.value.slice(end);
        const lead = before.length && !before.endsWith('\n') ? '\n' : '';
        const snippet = `${lead}${text}\n`;
        textarea.value = before + snippet + after;
        const caret = (before + snippet).length;
        textarea.selectionStart = textarea.selectionEnd = caret;
        textarea.focus();
      }

      async function addImages(files) {
        const images = Array.from(files).filter((f) => f.type.startsWith('image/'));
        if (images.length === 0) return false;
        for (const file of images) {
          setStatus('Uploading image…');
          try {
            const url = await uploadImage(file);
            insertAtCursor(els.body, `![](${url})`);
            syncDirty();
            updateBodyStats();
            setStatus('Image added — save to keep');
          } catch (err) {
            setStatus(err.message, 'err');
          }
        }
        return true;
      }

      // Pull image File objects out of a clipboard/drop payload. Note:
      // DataTransferItemList is array-like but NOT spread-iterable in Chrome/
      // Safari — Array.from() is required, [...items] throws.
      function imageFilesFrom(dt) {
        if (!dt) return [];
        let files = Array.from(dt.items ?? [])
          .filter((it) => it.kind === 'file')
          .map((it) => it.getAsFile())
          .filter((f) => f && f.type.startsWith('image/'));
        if (files.length === 0) {
          files = Array.from(dt.files ?? []).filter((f) => f.type.startsWith('image/'));
        }
        return files;
      }

      els.body.addEventListener('paste', (e) => {
        const files = imageFilesFrom(e.clipboardData);
        if (files.length === 0) return; // plain text → let the textarea handle it
        e.preventDefault();
        addImages(files);
      });

      els.body.addEventListener('dragover', (e) => {
        if (Array.from(e.dataTransfer?.items ?? []).some((it) => it.type.startsWith('image/'))) {
          e.preventDefault();
        }
      });

      els.body.addEventListener('drop', (e) => {
        const files = imageFilesFrom(e.dataTransfer);
        if (files.length === 0) return;
        e.preventDefault();
        addImages(files);
      });

      // ---- /image (alias /file): a drop-or-browse popup -------------------
      const modal = document.getElementById('image-modal');
      const dropzone = document.getElementById('dropzone');
      const modalStatus = document.getElementById('modal-status');
      const filePicker = document.getElementById('file-picker');

      function setModalStatus(text = '', kind = '') {
        modalStatus.textContent = text;
        modalStatus.dataset.kind = kind;
      }

      function openImageModal() {
        setModalStatus('');
        dropzone.classList.remove('is-over');
        modal.hidden = false;
        dropzone.focus();
      }

      function closeImageModal() {
        modal.hidden = true;
        dropzone.classList.remove('is-over');
        els.body.focus();
      }

      async function addImagesFromModal(files) {
        const images = Array.from(files).filter((f) => f.type.startsWith('image/'));
        if (images.length === 0) {
          setModalStatus('That wasn’t an image', 'err');
          return;
        }
        setModalStatus('Uploading…');
        for (const file of images) {
          try {
            const url = await uploadImage(file);
            insertAtCursor(els.body, `![](${url})`);
            syncDirty();
            updateBodyStats();
          } catch (err) {
            setModalStatus(err.message, 'err');
            return;
          }
        }
        setStatus('Image added — save to keep');
        closeImageModal();
      }

      function browse() {
        filePicker.value = '';
        filePicker.click();
      }

      dropzone.addEventListener('click', browse);
      dropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          browse();
        }
      });
      filePicker.addEventListener('change', () => {
        if (filePicker.files?.length) addImagesFromModal(filePicker.files);
      });

      ['dragenter', 'dragover'].forEach((ev) =>
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          dropzone.classList.add('is-over');
        }),
      );
      ['dragleave', 'dragend'].forEach((ev) =>
        dropzone.addEventListener(ev, () => dropzone.classList.remove('is-over')),
      );
      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('is-over');
        if (e.dataTransfer?.files?.length) addImagesFromModal(e.dataTransfer.files);
      });

      modal.querySelectorAll('[data-close]').forEach((el) =>
        el.addEventListener('click', closeImageModal),
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeImageModal();
      });

      // Slash command: "/image" or "/file" + Enter opens the popup.
      els.body.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' || e.shiftKey) return;
        const caret = els.body.selectionStart;
        const match = els.body.value.slice(0, caret).match(/(?:^|\s)\/(image|file)$/i);
        if (!match) return;
        e.preventDefault();
        const cmdLen = 1 + match[1].length; // slash + word
        const before = els.body.value.slice(0, caret - cmdLen);
        const after = els.body.value.slice(caret);
        els.body.value = before + after;
        els.body.selectionStart = els.body.selectionEnd = before.length;
        openImageModal();
      });

      // Saving writes a file inside src/content/, and Astro answers any content
      // change by telling every client to reload (a full-reload with path '*',
      // from its content virtual-module plugin). That was throwing away the
      // open tab, the selected file and the caret on every single save.
      //
      // This editor reads everything through its own API, so it has no use for
      // that reload — cancel it by rewriting the path to an .html file that
      // can't match this page, which is the one branch of Vite's client that
      // returns without reloading. Reloads for anything else (including edits
      // to this page's own source) still come through untouched.
      if (import.meta.hot) {
        import.meta.hot.on('vite:beforeFullReload', (payload) => {
          if (payload.path !== '*') return;
          payload.path = '/__editor-keeps-its-state.html';
          // Still worth knowing the files moved — refresh the sidebar, but
          // never the form, so a draft in progress is left alone.
          loadList().catch(() => {});
        });
      }

      async function boot() {
        // Restore whatever the URL is pointing at, so a refresh — or a reload
        // that slips past the guard above — lands back where you were.
        const params = new URLSearchParams(location.search);
        const wantId = params.get('id');

        try {
          const loaded = await loadList();
          const target = loaded.find((it) => it.id === wantId) ?? loaded[0];
          if (target) {
            await openItem(target.id);
          } else {
            blankForm();
          }
        } catch (err) {
          blankForm();
          setStatus(err.message, 'err');
        }
      }

      boot();
    </script>

    <!-- Global, not scoped: the sidebar rows are built in JS with
         createElement, so they never carry the data-astro-cid attribute that
         scoped selectors compile down to and would go completely unstyled.
         This page is a standalone document, so there's nothing to leak into. -->
    <style is:global>
      /* Same quiet system as the blog: one monospace, white page, greys,
         and the orange accent kept for focus and the open file. */
      :root {
        --bg: #ffffff;
        --surface: #fafafa;
        --ink: #1a1a1d;
        --ink-soft: #707177;
        --hair: rgba(26, 26, 29, 0.08);
        --hair-strong: rgba(26, 26, 29, 0.16);
        --accent: #e8461a;
        --danger: #c0392b;
        --ok: #2e7d4f;
        --amber: #a8701a;
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      html, body { height: 100%; }

      body {
        display: flex;
        flex-direction: column;
        color: var(--ink);
        background: var(--bg);
        font-family: var(--mono);
        font-size: 14px;
        -webkit-font-smoothing: antialiased;
      }

      ::selection { background: var(--accent); color: #fff; }

      /* ---- Header --------------------------------------------------------- */
      .top {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--hair);
      }

      .brand {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }

      .site-name {
        color: var(--ink);
        text-decoration: none;
      }

      .site-name:hover { color: var(--accent); }

      .badge { color: var(--ink-soft); }

      .actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
      }

      /* A confirmation you catch peripherally: it slides in, then leaves on its
         own. Errors are the exception and stay put until superseded. */
      .status {
        font-size: 0.8rem;
        color: var(--ink-soft);
        opacity: 0;
        transform: translateY(-2px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        white-space: nowrap;
      }

      .status.is-on { opacity: 1; transform: none; }
      .status[data-kind='ok'] { color: var(--ok); }
      .status[data-kind='err'] { color: var(--danger); }

      /* ---- Buttons -------------------------------------------------------- */
      button, .ghost {
        font: inherit;
        font-size: 0.8rem;
        border: 1px solid var(--hair-strong);
        background: transparent;
        color: var(--ink);
        border-radius: 3px;
        padding: 0.45rem 0.8rem;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease, transform 0.08s ease;
      }

      button:hover, .ghost:hover { border-color: var(--ink-soft); color: var(--accent); }
      button:active { transform: translateY(1px); }

      button:focus-visible, .ghost:focus-visible, .item:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      button:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }
      button:disabled:hover { border-color: var(--hair-strong); color: var(--ink); }

      .tiny { font-size: 0.75rem; padding: 0.3rem 0.6rem; }

      button.primary {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 2.4rem;
        border-color: var(--ink-soft);
      }

      /* Unsaved changes turn the save button orange — the same signal as the
         asterisk on the filename. */
      button.primary.is-dirty {
        color: var(--accent);
        border-color: var(--accent);
      }

      .primary kbd {
        font: inherit;
        font-size: 0.7rem;
        opacity: 0.5;
      }

      button.danger {
        color: var(--danger);
        border-color: rgba(192, 57, 43, 0.3);
      }

      button.danger:hover { border-color: var(--danger); color: var(--danger); }

      button.danger.solid {
        background: var(--danger);
        border-color: var(--danger);
        color: #fff;
      }

      .api-banner {
        margin: 0;
        padding: 0.6rem 1.25rem;
        font-size: 0.8rem;
        color: var(--danger);
        background: rgba(192, 57, 43, 0.06);
        border-bottom: 1px solid rgba(192, 57, 43, 0.18);
      }

      .api-banner code { font-family: var(--mono); }

      /* ---- Layout --------------------------------------------------------- */
      .layout {
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(230px, 290px) 1fr;
      }

      aside {
        display: flex;
        flex-direction: column;
        min-height: 0;
        border-right: 1px solid var(--hair);
        padding: 1rem 0.75rem 0.75rem;
        gap: 0.6rem;
      }

      .sidebar-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0 0.4rem;
      }

      .sidebar-label {
        display: flex;
        align-items: baseline;
        gap: 0.45rem;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .count {
        font-size: 0.75rem;
        opacity: 0.7;
        font-variant-numeric: tabular-nums;
      }

      #search { font-size: 0.8rem; padding: 0.45rem 0.6rem; }

      #search::-webkit-search-cancel-button { -webkit-appearance: none; }

      .item-list {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        padding-bottom: 0.5rem;
      }

      /* Rows read like a file tree: the open one gets a "> " cursor and the
         accent, the rest are indented to match. */
      .item {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.25rem;
        text-align: left;
        font-size: 0.85rem;
        border: 0;
        border-radius: 3px;
        padding: 0.55rem 0.6rem 0.6rem 1.6rem;
        background: transparent;
        position: relative;
        color: var(--ink-soft);
      }

      .item::before {
        content: '>';
        position: absolute;
        left: 0.6rem;
        top: 0.55rem;
        opacity: 0;
        color: var(--accent);
        transition: opacity 0.15s ease, transform 0.15s ease;
        transform: translateX(-3px);
      }

      .item:hover { background: rgba(26, 26, 29, 0.03); color: var(--ink); }
      .item:hover::before { opacity: 0.5; transform: none; }
      .item:active { transform: none; }

      .item.is-active { color: var(--ink); background: rgba(26, 26, 29, 0.05); }
      .item.is-active::before { opacity: 1; transform: none; }

      .item-title {
        line-height: 1.35;
        /* Long devlog titles run to three lines otherwise, which makes every
           row a different height and the list hard to scan. */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .item-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.7rem;
        color: var(--ink-soft);
        font-variant-numeric: tabular-nums;
      }

      .flag-draft { color: var(--amber); }

      .item.is-broken .item-title { color: var(--danger); }

      .empty-list {
        font-size: 0.8rem;
        color: var(--ink-soft);
        padding: 0.5rem 0.75rem;
      }

      main {
        overflow-y: auto;
        padding: 1rem clamp(1rem, 3vw, 2rem) 2rem;
      }

      form {
        max-width: 54rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      /* ---- File bar ------------------------------------------------------- */
      .file-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 1.9rem;
      }

      .editor-target {
        font-size: 0.8rem;
        color: var(--ink-soft);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .editor-target.is-dirty::after {
        content: ' *';
        color: var(--accent);
      }

      .file-bar-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
      }

      .save-line {
        min-height: 1.2em;
        margin-top: -0.4rem;
        font-size: 0.8rem;
        color: var(--ink-soft);
        white-space: pre;
      }

      /* ---- Panels --------------------------------------------------------- */
      .panel {
        background: var(--surface);
        border: 1px solid var(--hair);
        border-radius: 4px;
        padding: 1.1rem 1.15rem;
      }

      .panel-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.9rem;
      }

      .panel-title {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--ink-soft);
        margin-bottom: 0.9rem;
      }

      .panel-title::before { content: '// '; opacity: 0.5; }

      .panel-head .panel-title { margin-bottom: 0; }

      .body-stats {
        font-size: 0.75rem;
        color: var(--ink-soft);
        font-variant-numeric: tabular-nums;
      }

      .field-stack,
      .field-row {
        display: flex;
        gap: 0.85rem;
        margin-bottom: 0.85rem;
      }

      .field-stack { flex-direction: column; }
      .field-row { flex-wrap: wrap; align-items: flex-end; }
      .field-row:last-child,
      .field-stack:last-child { margin-bottom: 0; }

      label {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
      }

      label.grow { flex: 1 1 12rem; }

      label > span {
        font-size: 0.72rem;
        color: var(--ink-soft);
      }

      label.toggle {
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        padding-bottom: 0.55rem;
        flex: 0 0 auto;
        cursor: pointer;
      }

      label.toggle > span {
        font-size: 0.85rem;
        color: var(--ink);
      }

      input, select, textarea {
        font: inherit;
        font-size: 0.9rem;
        color: var(--ink);
        border: 1px solid var(--hair-strong);
        border-radius: 3px;
        padding: 0.55rem 0.65rem;
        background: var(--bg);
        transition: border-color 0.15s ease;
      }

      input:focus, select:focus, textarea:focus {
        outline: none;
        border-color: var(--accent);
      }

      #post-title {
        font-weight: 600;
        font-size: 1rem;
      }

      label.toggle input {
        width: 1rem;
        height: 1rem;
        padding: 0;
        accent-color: var(--accent);
        cursor: pointer;
      }

      .body-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
      }

      textarea {
        flex: 1;
        min-height: calc(100vh - 26rem);
        resize: vertical;
        line-height: 1.7;
        font-size: 0.88rem;
      }

      /* Arrival: the chrome settles, then the panels rise into it. */
      @media (prefers-reduced-motion: no-preference) {
        .top { animation: settle 0.5s cubic-bezier(0.2, 0.65, 0.2, 1) both; }
        aside { animation: fade 0.6s ease 0.06s both; }
        .file-bar { animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.1s both; }
        .fields:not([hidden]) { animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.14s both; }
        .body-panel { animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.2s both; }
      }

      @keyframes rise {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
      }
      @keyframes settle {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: none; }
      }
      @keyframes fade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @media (max-width: 900px) {
        .layout { grid-template-columns: 1fr; }

        aside {
          max-height: 14rem;
          border-right: none;
          border-bottom: 1px solid var(--hair);
        }

        textarea { min-height: 20rem; }
      }

      /* ---- Confirm dialog -------------------------------------------------- */
      dialog.ask {
        border: none;
        padding: 0;
        background: transparent;
        color: var(--ink);
        max-width: min(28rem, calc(100vw - 2rem));
        margin: auto;
      }

      dialog.ask::backdrop {
        background: rgba(26, 26, 29, 0.25);
      }

      dialog.ask form {
        max-width: none;
        gap: 0;
        background: var(--surface);
        border: 1px solid var(--hair-strong);
        border-radius: 4px;
        padding: 1.4rem 1.5rem 1.2rem;
      }

      dialog.ask h2 {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.4;
      }

      dialog.ask p {
        margin-top: 0.7rem;
        font-size: 0.85rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }

      dialog.ask menu {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1.4rem;
        list-style: none;
      }

      @media (prefers-reduced-motion: no-preference) {
        dialog.ask[open] { animation: ask-in 0.2s cubic-bezier(0.2, 0.65, 0.2, 1); }
        dialog.ask[open]::backdrop { animation: fade 0.2s ease; }
      }

      @keyframes ask-in {
        from { opacity: 0; transform: translateY(8px) scale(0.98); }
        to { opacity: 1; transform: none; }
      }

      /* ---- Image popup --------------------------------------------------- */
      .modal[hidden] { display: none; }

      .modal {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: grid;
        place-items: center;
        padding: 1.5rem;
      }

      .modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(26, 26, 29, 0.25);
      }

      .modal-card {
        position: relative;
        width: min(30rem, 100%);
        background: var(--surface);
        border: 1px solid var(--hair-strong);
        border-radius: 4px;
        padding: 1.5rem;
      }

      .modal-close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: grid;
        place-items: center;
        font-size: 1.1rem;
        line-height: 1;
        border-color: transparent;
        color: var(--ink-soft);
      }

      .dropzone {
        display: grid;
        place-items: center;
        text-align: center;
        min-height: 12rem;
        border: 1px dashed var(--hair-strong);
        border-radius: 4px;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease;
      }

      .dropzone:hover { border-color: var(--ink-soft); }
      .dropzone:focus-visible { outline: none; border-color: var(--accent); }

      .dropzone.is-over {
        border-color: var(--accent);
        background: rgba(232, 70, 26, 0.04);
      }

      .dropzone-title {
        font-size: 0.95rem;
        font-weight: 600;
      }

      .dropzone-sub {
        margin-top: 0.35rem;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .modal-status {
        margin-top: 0.9rem;
        min-height: 1.2rem;
        text-align: center;
        font-size: 0.8rem;
        color: var(--ink-soft);
      }

      .modal-status[data-kind='err'] { color: var(--danger); }
    </style>
  </body>
</html>
