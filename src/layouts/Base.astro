---
// Base.astro — the shared site chrome for every page except the canvas landing.
// It carries the white page, the sticky nav, the footer, and the whole
// typographic system as global styles — everything is set in one monospace,
// kept quiet: small sizes, greys, and a single accent saved for hover. Pages
// that use it only emit semantic markup.
//
// Pass page-specific <link>/<meta> through the named "head" slot.
//
// Navigation between blog pages goes through Astro's ClientRouter, so the
// page swaps in place instead of reloading: the critters and the scrollbar are
// persisted across it. Page scripts therefore run once — anything that binds
// to page content must do it on `astro:page-load`.
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  /** Inside a post, the nav's name becomes "blog" and leads back to the
   *  index; elsewhere it's "bill wang" and leads home. */
  inPost?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  inPost = false,
} = Astro.props;
---

<!doctype html>
<!-- No view-transition crossfade: the sink/rise animations below already
     carry the page change, and the persisted critters shouldn't blink. -->
<html lang="en" transition:animation="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bill Wang — Blog"
      href="/rss.xml"
    />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,600;1,400&display=swap"
    />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-nav">
      {
        inPost ? (
          <a class="site-name" href="/blog">blog</a>
        ) : (
          <a class="site-name" href="/">bill wang</a>
        )
      }
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-rule" aria-hidden="true"></p>
      <p class="footer-links">
        <a href="mailto:me@billwang.dev">me@billwang.dev</a>
        <a href="https://github.com/billwang7599">github</a>
        <a href="https://www.linkedin.com/in/bw7599">linkedin</a>
        <a href="/rss.xml">rss</a>
      </p>
    </footer>

    <!-- Custom scrollbar. The native one is hidden site-wide; this is its
         replacement — a hairline thumb that surfaces while you scroll, and is
         draggable/clickable like the real thing. Driven by the script below. -->
    <div class="scrollbar" aria-hidden="true" hidden transition:persist="scrollbar">
      <div class="thumb"></div>
    </div>

    <!-- ASCII critters playing along the bottom edge, behind the content.
         Persisted across navigation, and saved to localStorage so a refresh
         picks up where they left off. Skipped entirely under reduced motion. -->
    <div class="critters" aria-hidden="true" transition:persist="critters"></div>

    <script>
      import { mountCritters } from '../scripts/critters';
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        mountCritters(document.querySelector<HTMLElement>('.critters')!);
      }
    </script>

    <script>
      // Smooth internal navigation: the page sinks away while the next one
      // loads, then the new content rises in (its arrival animations run as it
      // is swapped in). The ClientRouter does the navigating; this only holds
      // the swap until the sink has played.
      const SINK_MS = 340;

      // A back/forward restore (bfcache) can bring back a page left mid-fade.
      // Clear the leaving state so it's visible again.
      window.addEventListener('pageshow', () => document.body.classList.remove('is-leaving'));

      document.addEventListener('astro:before-preparation', (e) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const load = e.loader;
        e.loader = async () => {
          document.body.classList.add('is-leaving');
          await Promise.all([load(), new Promise((r) => setTimeout(r, SINK_MS))]);
        };
      });
    </script>

    <script>
      // Eased scrolling + the custom scrollbar. The native bar is hidden in CSS;
      // everything visible on the right edge is driven from here.
      //
      // The easing is a lerp toward a target offset rather than a transformed
      // wrapper, so the sticky nav, the fixed grain layer and anchor offsets all
      // keep working untouched.
      const bar = document.querySelector<HTMLElement>('.scrollbar')!;
      const thumb = bar.querySelector<HTMLElement>('.thumb')!;
      const docEl = document.documentElement;

      const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
      const maxScroll = () => Math.max(0, docEl.scrollHeight - window.innerHeight);

      // Touch already has momentum of its own, and reduced-motion asks for none.
      // In both cases the scrollbar still runs; only the easing is skipped.
      const eased =
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- the eased loop ---------------------------------------------- */
      let current = window.scrollY; // our float position, free of pixel rounding
      let target = current;
      let raf: number | null = null;

      const step = () => {
        const diff = target - current;
        if (Math.abs(diff) < 0.4) {
          current = target;
          raf = null;
        } else {
          current += diff * 0.16;
          raf = requestAnimationFrame(step);
        }
        window.scrollTo({ top: current, behavior: 'instant' as ScrollBehavior });
      };

      const easeTo = (y: number) => {
        target = clamp(y, 0, maxScroll());
        if (!eased) {
          window.scrollTo({ top: target, behavior: 'smooth' });
          return;
        }
        if (raf === null) {
          current = window.scrollY;
          raf = requestAnimationFrame(step);
        }
      };

      // Used while dragging the thumb, where the position should track the
      // pointer exactly rather than trail behind it.
      const jumpTo = (y: number) => {
        current = target = clamp(y, 0, maxScroll());
        window.scrollTo({ top: current, behavior: 'instant' as ScrollBehavior });
      };

      // A wheel over something with its own scroll (a wide code block) belongs
      // to that element, not the page.
      const scrollsItself = (node: EventTarget | null) => {
        let el: Element | null = node instanceof Element ? node : null;
        while (el && el !== document.body) {
          const s = getComputedStyle(el);
          if (/auto|scroll/.test(s.overflowY) && el.scrollHeight > el.clientHeight) return true;
          if (/auto|scroll/.test(s.overflowX) && el.scrollWidth > el.clientWidth) return true;
          el = el.parentElement;
        }
        return false;
      };

      if (eased) {
        docEl.classList.add('has-eased-scroll');
        window.addEventListener(
          'wheel',
          (e) => {
            if (e.ctrlKey) return; // pinch-zoom
            if (scrollsItself(e.target)) return;
            const max = maxScroll();
            if (max <= 0) return;
            e.preventDefault();
            // Anything that moved the page since the last frame (keys, find-in-
            // page) is now the truth — start from there.
            if (raf === null) current = target = window.scrollY;
            const lines = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
            target = clamp(target + e.deltaY * lines, 0, max);
            if (raf === null) raf = requestAnimationFrame(step);
          },
          { passive: false },
        );
      }

      // In-page anchors: html's `scroll-behavior: smooth` is off while the loop
      // owns scrolling, so ease them here instead — offset to clear the nav.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const href = (e.target as HTMLElement).closest('a')?.getAttribute('href');
        if (!href || href.length < 2 || !href.startsWith('#')) return;
        const el = document.getElementById(decodeURIComponent(href.slice(1)));
        if (!el) return;
        e.preventDefault();
        history.pushState(null, '', href);
        easeTo(el.getBoundingClientRect().top + window.scrollY - 96);
      });

      /* ---- the scrollbar ------------------------------------------------ */
      let hideTimer: number | undefined;
      let dragging = false;

      const draw = () => {
        const max = maxScroll();
        if (max <= 0) {
          bar.hidden = true;
          return;
        }
        bar.hidden = false;
        const track = bar.clientHeight;
        const h = Math.max(32, Math.round(track * (window.innerHeight / docEl.scrollHeight)));
        const y = (track - h) * (clamp(window.scrollY, 0, max) / max);
        thumb.style.height = `${h}px`;
        thumb.style.transform = `translateY(${y}px)`;
      };

      const flash = () => {
        bar.classList.add('is-visible');
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => bar.classList.remove('is-visible'), 900);
      };

      window.addEventListener(
        'scroll',
        () => {
          // Keep the loop honest about scrolls it didn't cause.
          if (raf === null) current = target = window.scrollY;
          draw();
          flash();
        },
        { passive: true },
      );

      // Drag the thumb.
      let grabY = 0;
      let grabScroll = 0;
      thumb.addEventListener('pointerdown', (e) => {
        dragging = true;
        grabY = e.clientY;
        grabScroll = window.scrollY;
        bar.classList.add('is-dragging');
        thumb.setPointerCapture(e.pointerId);
        e.preventDefault();
        e.stopPropagation(); // not also a track click
      });
      thumb.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const room = bar.clientHeight - thumb.offsetHeight;
        if (room <= 0) return;
        jumpTo(grabScroll + ((e.clientY - grabY) * maxScroll()) / room);
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        bar.classList.remove('is-dragging');
        flash();
      };
      thumb.addEventListener('pointerup', endDrag);
      thumb.addEventListener('pointercancel', endDrag);

      // Click the track to ease to that spot.
      bar.addEventListener('pointerdown', (e) => {
        const room = bar.clientHeight - thumb.offsetHeight;
        if (room <= 0) return;
        const y = clamp(
          e.clientY - bar.getBoundingClientRect().top - thumb.offsetHeight / 2,
          0,
          room,
        );
        easeTo((y / room) * maxScroll());
      });

      // The page grows as images load and as the tag filter hides rows.
      const sizes = new ResizeObserver(draw);
      sizes.observe(document.body);
      window.addEventListener('resize', draw);
      draw();

      // A client-side navigation swaps in a new <body> and replaces <html>'s
      // attributes, so watch the new body and restore the easing class.
      document.addEventListener('astro:after-swap', () => {
        if (eased) docEl.classList.add('has-eased-scroll');
        sizes.disconnect();
        sizes.observe(document.body);
        current = target = window.scrollY;
        draw();
      });
    </script>

    <style is:global>
      :root {
        --bg: #ffffff;
        --ink: #1a1a1d;
        --ink-soft: #707177;
        --faint: #cfd0d4;
        --hair: rgba(26, 26, 29, 0.08);
        --accent: #e8461a;
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --measure: 46rem;
        --gutter: clamp(1.25rem, 5vw, 2.5rem);
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        /* Match the page so a pull past the top/bottom never flashes another
           colour, and stop the bounce itself on the vertical axis. */
        background: var(--bg);
        overscroll-behavior-y: none;
        /* No native gutter — .scrollbar below stands in for it. */
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      html::-webkit-scrollbar {
        display: none;
      }
      /* The rAF easing below drives scrollTo frame by frame; native smooth
         behaviour on top of that would fight it. Anchors get their easing from
         the same loop instead. */
      html.has-eased-scroll {
        scroll-behavior: auto;
      }
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--ink);
        background: var(--bg);
        font-family: var(--mono);
        font-size: 0.875rem;
        -webkit-font-smoothing: antialiased;
      }
      ::selection {
        background: var(--accent);
        color: #fff;
      }
      :focus-visible {
        outline: 1px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---- Custom scrollbar ---------------------------------------------- */
      /* Sits in the right margin, past the content, so it never crosses text.
         Idle-hidden; the script fades it in while the page is moving. */
      .scrollbar {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 11px;
        z-index: 3;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .scrollbar.is-visible,
      .scrollbar.is-dragging,
      .scrollbar:hover {
        opacity: 1;
      }
      .scrollbar .thumb {
        position: absolute;
        top: 0;
        right: 4px;
        width: 3px;
        border-radius: 999px;
        background: rgba(26, 26, 29, 0.22);
        cursor: grab;
        transition:
          width 0.18s ease,
          background 0.18s ease;
      }
      .scrollbar:hover .thumb,
      .scrollbar.is-dragging .thumb {
        width: 5px;
        background: rgba(26, 26, 29, 0.4);
      }
      .scrollbar.is-dragging .thumb {
        cursor: grabbing;
      }
      /* Touch has its own transient indicator, and an 11px strip pinned to the
         edge of a phone screen is only in the way. */
      @media (pointer: coarse) {
        .scrollbar {
          display: none;
        }
      }
      /* Code blocks keep their own horizontal scroll — give it the same
         hairline treatment rather than the platform default. */
      .prose pre::-webkit-scrollbar {
        height: 7px;
      }
      .prose pre::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.25);
      }
      .prose pre {
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
      }

      /* ---- Site chrome --------------------------------------------------- */
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        max-width: calc(var(--measure) + 2 * var(--gutter));
        margin: 0 auto;
        padding: 1.25rem var(--gutter);
        background: var(--bg);
        font-size: 0.8rem;
      }
      .site-nav a {
        color: var(--ink);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .site-nav a:hover {
        color: var(--ink);
      }

      /* ---- Critters ------------------------------------------------------ */
      /* A strip pinned to the viewport floor. main and the footer sit above it
         (z-index 1), so text always paints over the critters, never under. */
      .critters {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: 3rem;
        z-index: 0;
        pointer-events: none;
        user-select: none;
        font-size: 0.75rem;
        color: var(--faint);
      }
      .critter {
        position: absolute;
        left: 0;
        bottom: 0.6rem;
        white-space: nowrap;
        will-change: transform;
      }
      .critter .bubble {
        position: absolute;
        left: 50%;
        bottom: 100%;
        transform: translateX(-50%);
        font-size: 0.65rem;
        color: var(--ink-soft);
        opacity: 0;
        transition: opacity 0.25s ease;
      }
      .critter .bubble.on {
        opacity: 0.7;
      }

      /* ---- Page wrapper -------------------------------------------------- */
      main {
        position: relative;
        z-index: 1;
        flex: 1;
        width: 100%;
        max-width: calc(var(--measure) + 2 * var(--gutter));
        margin: 0 auto;
        padding: clamp(1rem, 4vw, 2rem) var(--gutter) clamp(4rem, 10vw, 6rem);
      }

      /* Arrival: blocks rise in, staggered; list rows cascade via --i. */
      @media (prefers-reduced-motion: no-preference) {
        .site-nav {
          opacity: 0;
          animation: nav-in 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.02s both;
        }
        .page-header,
        .filters,
        .post-header,
        .prose,
        .entries > li {
          opacity: 0;
          animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) both;
        }
        .page-header,
        .post-header {
          animation-delay: 0.06s;
        }
        .filters {
          animation-delay: 0.16s;
        }
        .prose {
          animation-delay: 0.2s;
        }
        .entries > li {
          animation-delay: calc(0.22s + var(--i, 0) * 0.04s);
        }

        /* Leaving: the page sinks away before navigating. Set by the inline
           navigation script above. */
        body.is-leaving .site-nav,
        body.is-leaving main,
        body.is-leaving .site-footer {
          animation: sink 0.34s cubic-bezier(0.4, 0, 1, 1) both;
        }
      }
      body.is-leaving {
        pointer-events: none;
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes nav-in {
        from {
          opacity: 0;
          transform: translateY(-8px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      /* The `from` is spelled out on purpose. Without it the start value comes
         from each element's underlying style, and .site-nav declares
         `opacity: 0` (nav-in only holds it at 1 through its fill). Swapping in
         this animation cancels nav-in, so the bar would snap straight to
         invisible in a single frame while main and the footer fade out around
         it. */
      @keyframes sink {
        from {
          opacity: 1;
          transform: none;
        }
        to {
          opacity: 0;
          transform: translateY(8px);
        }
      }

      .empty {
        font-size: 0.85rem;
        color: var(--ink-soft);
        padding: 0.5rem 0;
      }

      /* ---- Entry list (posts) ------------------------------------------- */
      /* Each post is one line — title, dotted leader, date — with its
         description underneath. */
      .entries {
        list-style: none;
      }
      .entries .row {
        display: block;
        padding: 0.9rem 0;
        color: var(--ink);
        text-decoration: none;
      }
      .entries .line {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
      }
      .entries .title {
        min-width: 0;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.5;
        text-transform: lowercase;
        transition: color 0.15s ease;
      }
      .entries .row:hover .title,
      .entries .row:focus-visible .title {
        color: var(--accent);
      }
      .entries .leader {
        flex: 1;
        min-width: 1.5rem;
        border-bottom: 1px dotted var(--faint);
        transform: translateY(-0.25rem);
      }
      .entries .date {
        font-size: 0.75rem;
        color: var(--ink-soft);
        white-space: nowrap;
      }
      .entries .blurb {
        display: block;
        margin-top: 0.15rem;
        font-size: 0.8rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }
      @media (max-width: 560px) {
        .entries .leader,
        .entries .date {
          display: none;
        }
      }

      /* ---- Tags (post header) ------------------------------------------- */
      .tag {
        font-size: 0.75rem;
        color: var(--ink-soft);
      }
      .tag::before {
        content: '#';
        color: var(--faint);
      }

      /* ---- Footer -------------------------------------------------------- */
      .site-footer {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: calc(var(--measure) + 2 * var(--gutter));
        margin: 0 auto;
        padding: 0 var(--gutter) clamp(1.5rem, 4vw, 2.5rem);
        font-size: 0.75rem;
        color: var(--ink-soft);
      }
      /* An ASCII rule, cut to whatever width the footer has. */
      .footer-rule {
        overflow: hidden;
        white-space: nowrap;
        margin-bottom: 1rem;
        color: var(--faint);
      }
      .footer-rule::before {
        content: '·─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────·';
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
      }
      .site-footer a {
        color: var(--ink-soft);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .site-footer a:hover {
        color: var(--ink);
      }

      /* ---- Prose (rendered Markdown, used by posts) -------- */
      .prose {
        font-size: 0.9rem;
        line-height: 1.8;
        color: var(--ink);
      }
      .prose > * + * {
        margin-top: 1.2rem;
      }
      /* Headings keep their Markdown hashes, faintly. */
      .prose h2,
      .prose h3 {
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.4;
        margin-top: 2.4rem;
      }
      .prose h2::before {
        content: '## ';
        color: var(--faint);
      }
      .prose h3::before {
        content: '### ';
        color: var(--faint);
      }
      .prose a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--faint);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition:
          color 0.15s ease,
          text-decoration-color 0.15s ease;
      }
      .prose a:hover {
        color: var(--accent);
        text-decoration-color: var(--accent);
      }
      .prose ul,
      .prose ol {
        padding-left: 1.4rem;
      }
      .prose li + li {
        margin-top: 0.35rem;
      }
      .prose ul li::marker {
        content: '- ';
        color: var(--ink-soft);
      }
      .prose blockquote {
        border-left: 1px solid var(--faint);
        padding-left: 1.2rem;
        color: var(--ink-soft);
      }
      .prose img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
      }
      .prose hr {
        border: 0;
        text-align: center;
        color: var(--faint);
      }
      .prose hr::before {
        content: '* * *';
      }
      .prose code {
        font-family: var(--mono);
        font-size: 0.92em;
        background: rgba(26, 26, 29, 0.05);
        padding: 0.1em 0.3em;
        border-radius: 3px;
      }
      .prose pre {
        font-size: 0.8rem;
        line-height: 1.65;
        padding: 1rem 1.2rem;
        border-radius: 4px;
        overflow-x: auto;
      }
      .prose pre code {
        background: none;
        padding: 0;
        border-radius: 0;
        font-size: inherit;
      }
    </style>
  </body>
</html>
