---
// Base.astro — the shared site chrome for every page except the canvas landing.
// It carries the white page, the sticky nav, the footer, and the whole
// typographic system as global styles: tall condensed display type for titles,
// monospace for anything that's metadata, a plain sans for reading. Pages that
// use it only emit semantic markup.
//
// Pass page-specific <link>/<meta> through the named "head" slot.
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  current?: 'blog';
  /** Widen <main> past the reading measure (the blog index, with its card). */
  wide?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  current,
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bill Wang — Blog"
      href="/rss.xml"
    />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@300;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-nav">
      <a class="site-name" href="/">bill wang</a>
      <nav aria-label="Site">
        <a href="/">card</a>
        <a
          href="/blog"
          class={current === 'blog' ? 'current' : undefined}
          aria-current={current === 'blog' ? 'page' : undefined}
          >blog</a
        >
        <a href="/rss.xml">rss</a>
      </nav>
    </header>

    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <p class="footer-rule" aria-hidden="true"></p>
      <p class="footer-links">
        <a href="mailto:me@billwang.dev">me@billwang.dev</a>
        <a href="https://github.com/billwang7599">github</a>
        <a href="https://www.linkedin.com/in/bw7599">linkedin</a>
        <a href="/rss.xml">rss</a>
      </p>
    </footer>

    <!-- Custom scrollbar. The native one is hidden site-wide; this is its
         replacement — a hairline thumb that surfaces while you scroll, and is
         draggable/clickable like the real thing. Driven by the script below. -->
    <div class="scrollbar" aria-hidden="true" hidden>
      <div class="thumb"></div>
    </div>

    <script>
      // Smooth internal navigation: fade the page out before leaving, so moving
      // between blog pages — and back to the landing card — reads as one
      // continuous move rather than a hard cut.
      const root = document.body;

      // A back/forward restore (bfcache) can bring back a page left mid-fade.
      // Clear the leaving state so it's visible again.
      window.addEventListener('pageshow', () => root.classList.remove('is-leaving'));

      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        const link = (e.target as HTMLElement).closest('a');
        if (!link) return;

        const href = link.getAttribute('href');
        if (!href || link.target === '_blank' || link.hasAttribute('download')) return;

        const url = new URL(href, location.href);
        if (url.origin !== location.origin) return; // external → let it be
        // Same-page hash (in-page anchor) → no transition.
        if (url.pathname + url.search === location.pathname + location.search) return;
        // Respect reduced motion — navigate immediately.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        e.preventDefault();
        root.classList.add('is-leaving');

        let navigated = false;
        const go = () => {
          if (navigated) return;
          navigated = true;
          location.href = url.href;
        };
        // Leave once the sink finishes. Ignore any in-flight arrival-reveal
        // animationend events; a timer guards against a missed event.
        root.addEventListener('animationend', (ev) => {
          if ((ev as AnimationEvent).animationName === 'sink') go();
        });
        setTimeout(go, 420);
      });
    </script>

    <script>
      // Eased scrolling + the custom scrollbar. The native bar is hidden in CSS;
      // everything visible on the right edge is driven from here.
      //
      // The easing is a lerp toward a target offset rather than a transformed
      // wrapper, so the sticky nav, the fixed grain layer and anchor offsets all
      // keep working untouched.
      const bar = document.querySelector<HTMLElement>('.scrollbar')!;
      const thumb = bar.querySelector<HTMLElement>('.thumb')!;
      const docEl = document.documentElement;

      const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
      const maxScroll = () => Math.max(0, docEl.scrollHeight - window.innerHeight);

      // Touch already has momentum of its own, and reduced-motion asks for none.
      // In both cases the scrollbar still runs; only the easing is skipped.
      const eased =
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- the eased loop ---------------------------------------------- */
      let current = window.scrollY; // our float position, free of pixel rounding
      let target = current;
      let raf: number | null = null;

      const step = () => {
        const diff = target - current;
        if (Math.abs(diff) < 0.4) {
          current = target;
          raf = null;
        } else {
          current += diff * 0.16;
          raf = requestAnimationFrame(step);
        }
        window.scrollTo({ top: current, behavior: 'instant' as ScrollBehavior });
      };

      const easeTo = (y: number) => {
        target = clamp(y, 0, maxScroll());
        if (!eased) {
          window.scrollTo({ top: target, behavior: 'smooth' });
          return;
        }
        if (raf === null) {
          current = window.scrollY;
          raf = requestAnimationFrame(step);
        }
      };

      // Used while dragging the thumb, where the position should track the
      // pointer exactly rather than trail behind it.
      const jumpTo = (y: number) => {
        current = target = clamp(y, 0, maxScroll());
        window.scrollTo({ top: current, behavior: 'instant' as ScrollBehavior });
      };

      // A wheel over something with its own scroll (a wide code block) belongs
      // to that element, not the page.
      const scrollsItself = (node: EventTarget | null) => {
        let el: Element | null = node instanceof Element ? node : null;
        while (el && el !== document.body) {
          const s = getComputedStyle(el);
          if (/auto|scroll/.test(s.overflowY) && el.scrollHeight > el.clientHeight) return true;
          if (/auto|scroll/.test(s.overflowX) && el.scrollWidth > el.clientWidth) return true;
          el = el.parentElement;
        }
        return false;
      };

      if (eased) {
        docEl.classList.add('has-eased-scroll');
        window.addEventListener(
          'wheel',
          (e) => {
            if (e.ctrlKey) return; // pinch-zoom
            if (scrollsItself(e.target)) return;
            const max = maxScroll();
            if (max <= 0) return;
            e.preventDefault();
            // Anything that moved the page since the last frame (keys, find-in-
            // page) is now the truth — start from there.
            if (raf === null) current = target = window.scrollY;
            const lines = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
            target = clamp(target + e.deltaY * lines, 0, max);
            if (raf === null) raf = requestAnimationFrame(step);
          },
          { passive: false },
        );
      }

      // In-page anchors: html's `scroll-behavior: smooth` is off while the loop
      // owns scrolling, so ease them here instead — offset to clear the nav.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const href = (e.target as HTMLElement).closest('a')?.getAttribute('href');
        if (!href || href.length < 2 || !href.startsWith('#')) return;
        const el = document.getElementById(decodeURIComponent(href.slice(1)));
        if (!el) return;
        e.preventDefault();
        history.pushState(null, '', href);
        easeTo(el.getBoundingClientRect().top + window.scrollY - 96);
      });

      /* ---- the scrollbar ------------------------------------------------ */
      let hideTimer: number | undefined;
      let dragging = false;

      const draw = () => {
        const max = maxScroll();
        if (max <= 0) {
          bar.hidden = true;
          return;
        }
        bar.hidden = false;
        const track = bar.clientHeight;
        const h = Math.max(32, Math.round(track * (window.innerHeight / docEl.scrollHeight)));
        const y = (track - h) * (clamp(window.scrollY, 0, max) / max);
        thumb.style.height = `${h}px`;
        thumb.style.transform = `translateY(${y}px)`;
      };

      const flash = () => {
        bar.classList.add('is-visible');
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => bar.classList.remove('is-visible'), 900);
      };

      window.addEventListener(
        'scroll',
        () => {
          // Keep the loop honest about scrolls it didn't cause.
          if (raf === null) current = target = window.scrollY;
          draw();
          flash();
        },
        { passive: true },
      );

      // Drag the thumb.
      let grabY = 0;
      let grabScroll = 0;
      thumb.addEventListener('pointerdown', (e) => {
        dragging = true;
        grabY = e.clientY;
        grabScroll = window.scrollY;
        bar.classList.add('is-dragging');
        thumb.setPointerCapture(e.pointerId);
        e.preventDefault();
        e.stopPropagation(); // not also a track click
      });
      thumb.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const room = bar.clientHeight - thumb.offsetHeight;
        if (room <= 0) return;
        jumpTo(grabScroll + ((e.clientY - grabY) * maxScroll()) / room);
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        bar.classList.remove('is-dragging');
        flash();
      };
      thumb.addEventListener('pointerup', endDrag);
      thumb.addEventListener('pointercancel', endDrag);

      // Click the track to ease to that spot.
      bar.addEventListener('pointerdown', (e) => {
        const room = bar.clientHeight - thumb.offsetHeight;
        if (room <= 0) return;
        const y = clamp(
          e.clientY - bar.getBoundingClientRect().top - thumb.offsetHeight / 2,
          0,
          room,
        );
        easeTo((y / room) * maxScroll());
      });

      // The page grows as images load and as the tag filter hides rows.
      new ResizeObserver(draw).observe(document.body);
      window.addEventListener('resize', draw);
      draw();
    </script>

    <style is:global>
      :root {
        --bg: #fcfcfc;
        --ink: #111113;
        --ink-soft: #5f6066;
        --hair: rgba(17, 17, 19, 0.12);
        --hair-strong: rgba(17, 17, 19, 0.24);
        --accent: #e8461a;
        --display: 'Big Shoulders Display', 'Arial Narrow', sans-serif;
        --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --sans: 'IBM Plex Sans', system-ui, sans-serif;
        --measure: 44rem;
        --wide: 70rem;
        --gutter: clamp(1.25rem, 5vw, 2.5rem);
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        /* Match the page so a pull past the top/bottom never flashes another
           colour, and stop the bounce itself on the vertical axis. */
        background: var(--bg);
        overscroll-behavior-y: none;
        /* No native gutter — .scrollbar below stands in for it. */
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      html::-webkit-scrollbar {
        display: none;
      }
      /* The rAF easing below drives scrollTo frame by frame; native smooth
         behaviour on top of that would fight it. Anchors get their easing from
         the same loop instead. */
      html.has-eased-scroll {
        scroll-behavior: auto;
      }
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: var(--ink);
        background: var(--bg);
        font-family: var(--sans);
        -webkit-font-smoothing: antialiased;
      }
      ::selection {
        background: var(--accent);
        color: #fff;
      }
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      /* ---- Custom scrollbar ---------------------------------------------- */
      /* Sits in the right margin, past the content, so it never crosses text.
         Idle-hidden; the script fades it in while the page is moving. */
      .scrollbar {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 11px;
        z-index: 3;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .scrollbar.is-visible,
      .scrollbar.is-dragging,
      .scrollbar:hover {
        opacity: 1;
      }
      .scrollbar .thumb {
        position: absolute;
        top: 0;
        right: 4px;
        width: 3px;
        border-radius: 999px;
        background: rgba(17, 17, 19, 0.3);
        cursor: grab;
        transition:
          width 0.18s ease,
          background 0.18s ease;
      }
      .scrollbar:hover .thumb,
      .scrollbar.is-dragging .thumb {
        width: 5px;
        background: var(--accent);
      }
      .scrollbar.is-dragging .thumb {
        cursor: grabbing;
      }
      /* Touch has its own transient indicator, and an 11px strip pinned to the
         edge of a phone screen is only in the way. */
      @media (pointer: coarse) {
        .scrollbar {
          display: none;
        }
      }
      /* Code blocks keep their own horizontal scroll — give it the same
         hairline treatment rather than the platform default. */
      .prose pre::-webkit-scrollbar {
        height: 7px;
      }
      .prose pre::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.25);
      }
      .prose pre {
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
      }

      /* ---- Site chrome --------------------------------------------------- */
      .site-nav {
        position: sticky;
        top: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        max-width: calc(var(--wide) + 2 * var(--gutter));
        margin: 0 auto;
        padding: 1.25rem var(--gutter);
        background: var(--bg);
        font-family: var(--mono);
        font-size: 0.85rem;
      }
      .site-nav a {
        color: var(--ink);
        text-decoration: none;
      }
      .site-name:hover {
        color: var(--accent);
      }
      .site-nav nav {
        display: flex;
        gap: 0.4rem;
      }
      /* Each link wears a pair of brackets: invisible until hovered, solid on
         the page you're on — so the current section reads as [blog]. */
      .site-nav nav a {
        color: var(--ink-soft);
        padding: 0.5rem 0.1rem;
        transition: color 0.15s ease;
      }
      .site-nav nav a::before,
      .site-nav nav a::after {
        opacity: 0;
        transition: opacity 0.15s ease;
      }
      .site-nav nav a::before {
        content: '[';
      }
      .site-nav nav a::after {
        content: ']';
      }
      .site-nav nav a:hover {
        color: var(--ink);
      }
      .site-nav nav a:hover::before,
      .site-nav nav a:hover::after {
        opacity: 1;
        color: var(--accent);
      }
      .site-nav nav a.current {
        color: var(--ink);
      }
      .site-nav nav a.current::before,
      .site-nav nav a.current::after {
        opacity: 1;
      }

      /* ---- Page wrapper -------------------------------------------------- */
      main {
        flex: 1;
        width: 100%;
        max-width: calc(var(--measure) + 2 * var(--gutter));
        margin: 0 auto;
        padding: clamp(1rem, 4vw, 2rem) var(--gutter) clamp(4rem, 10vw, 6rem);
      }
      main.wide {
        max-width: calc(var(--wide) + 2 * var(--gutter));
      }

      /* Arrival: blocks rise in, staggered; list rows cascade via --i. */
      @media (prefers-reduced-motion: no-preference) {
        .site-nav {
          opacity: 0;
          animation: nav-in 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) 0.02s both;
        }
        .page-header,
        .filters,
        .post-header,
        .prose,
        .entries > li {
          opacity: 0;
          animation: rise 0.6s cubic-bezier(0.2, 0.65, 0.2, 1) both;
        }
        .page-header,
        .post-header {
          animation-delay: 0.06s;
        }
        .filters {
          animation-delay: 0.16s;
        }
        .prose {
          animation-delay: 0.2s;
        }
        .entries > li {
          animation-delay: calc(0.22s + var(--i, 0) * 0.05s);
        }

        /* Leaving: the page sinks away before navigating. Set by the inline
           navigation script above. */
        body.is-leaving .site-nav,
        body.is-leaving main,
        body.is-leaving .site-footer {
          animation: sink 0.34s cubic-bezier(0.4, 0, 1, 1) both;
        }
      }
      body.is-leaving {
        pointer-events: none;
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes nav-in {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      /* The `from` is spelled out on purpose. Without it the start value comes
         from each element's underlying style, and .site-nav declares
         `opacity: 0` (nav-in only holds it at 1 through its fill). Swapping in
         this animation cancels nav-in, so the bar would snap straight to
         invisible in a single frame while main and the footer fade out around
         it. */
      @keyframes sink {
        from {
          opacity: 1;
          transform: none;
        }
        to {
          opacity: 0;
          transform: translateY(10px);
        }
      }

      /* ---- Shared type --------------------------------------------------- */
      .mono {
        font-family: var(--mono);
      }
      .display {
        font-family: var(--display);
        text-transform: uppercase;
      }
      .empty {
        font-family: var(--mono);
        font-size: 0.9rem;
        color: var(--ink-soft);
        padding: 0.5rem 0;
      }

      /* ---- Entry list (posts) ------------------------------------------- */
      .entries {
        list-style: none;
        border-bottom: 1px solid var(--hair);
      }
      .entries > li {
        border-top: 1px solid var(--hair);
      }
      .entries .row {
        display: grid;
        grid-template-columns: 2.75rem minmax(0, 1fr) auto;
        gap: 0 1.25rem;
        align-items: baseline;
        padding: 1.4rem 0;
        color: var(--ink);
        text-decoration: none;
      }
      .entries .num {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--ink-soft);
        transition: color 0.15s ease;
      }
      .entries .title {
        font-family: var(--display);
        font-weight: 500;
        font-size: clamp(1.9rem, 4.6vw, 2.6rem);
        line-height: 1;
        text-transform: uppercase;
        overflow-wrap: anywhere;
      }
      /* An ASCII arrow that draws itself out after the title on hover. The
         flex-end + overflow keeps its tip visible while the width grows. */
      .entries .trail {
        display: inline-flex;
        justify-content: flex-end;
        overflow: hidden;
        width: 0;
        vertical-align: 0.3em;
        font-family: var(--mono);
        font-size: 1rem;
        line-height: 1;
        color: var(--accent);
        transition: width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .entries .trail span {
        flex: 0 0 auto;
        white-space: pre;
      }
      .entries .row:hover .trail,
      .entries .row:focus-visible .trail {
        width: 8.5rem;
      }
      .entries .row:hover .num,
      .entries .row:focus-visible .num {
        color: var(--accent);
      }
      .entries .blurb {
        display: block;
        margin-top: 0.6rem;
        font-family: var(--mono);
        font-size: 0.85rem;
        line-height: 1.6;
        color: var(--ink-soft);
      }
      .entries .meta {
        font-family: var(--mono);
        font-size: 0.8rem;
        line-height: 1.6;
        color: var(--ink-soft);
        text-align: right;
        white-space: nowrap;
      }
      @media (max-width: 640px) {
        .entries .row {
          grid-template-columns: minmax(0, 1fr);
        }
        .entries .num {
          display: none;
        }
        .entries .meta {
          order: -1;
          text-align: left;
          margin-bottom: 0.4rem;
        }
      }

      /* ---- Tags (post header) ------------------------------------------- */
      .tag {
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--ink-soft);
      }
      .tag::before {
        content: '#';
        color: var(--accent);
      }

      /* ---- Footer -------------------------------------------------------- */
      .site-footer {
        width: 100%;
        max-width: calc(var(--wide) + 2 * var(--gutter));
        margin: 0 auto;
        padding: 0 var(--gutter) clamp(1.5rem, 4vw, 2.5rem);
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--ink-soft);
      }
      /* An ASCII rule, cut to whatever width the footer has. */
      .footer-rule {
        overflow: hidden;
        white-space: nowrap;
        margin-bottom: 1rem;
      }
      .footer-rule::before {
        content: '·─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────·';
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
      }
      .site-footer a {
        color: var(--ink-soft);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      .site-footer a:hover {
        color: var(--accent);
      }

      /* ---- Prose (rendered Markdown, used by posts) -------- */
      .prose {
        font-size: clamp(1.02rem, 2.4vw, 1.1rem);
        line-height: 1.75;
        color: var(--ink);
      }
      .prose > * + * {
        margin-top: 1.25rem;
      }
      .prose h2,
      .prose h3 {
        font-family: var(--display);
        font-weight: 500;
        text-transform: uppercase;
        line-height: 1;
        margin-top: 2.8rem;
      }
      .prose h2 {
        font-size: clamp(1.9rem, 5vw, 2.4rem);
      }
      .prose h3 {
        font-size: clamp(1.5rem, 4vw, 1.8rem);
      }
      .prose a {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
        transition: color 0.15s ease;
      }
      .prose a:hover {
        color: var(--accent);
      }
      .prose ul,
      .prose ol {
        padding-left: 1.4rem;
      }
      .prose li + li {
        margin-top: 0.4rem;
      }
      .prose ul li::marker {
        content: '- ';
        font-family: var(--mono);
        color: var(--accent);
      }
      .prose blockquote {
        border-left: 2px solid var(--accent);
        padding-left: 1.2rem;
