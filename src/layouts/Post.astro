---
// Single blog-post layout. Sits on Base for all shared chrome and prose styling;
// adds the post header (kicker, title, dateline, reading time, tags) and the
// back link. The rendered Markdown body arrives through <slot />.
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  slug: string;
  minutes: number;
  project?: { slug: string; title: string };
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  slug,
  minutes,
  project,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const canonical = `https://billwang.dev/writing/${slug}`;
---

<Base
  title={`${title} — Bill Wang`}
  description={description}
  canonical={canonical}
  ogType="article"
  current="writing"
>
  <!-- Typesets the build-time KaTeX output in posts that use math. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
  />

  <article>
    <header class="post-header">
      <p class="kicker">
        {
          project ? (
            <a href={`/projects/${project.slug}`}>
              <span class="lead">Part of</span>
              <span class="name">{project.title}</span>
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          ) : (
            <a href="/writing">
              <span class="arrow back" aria-hidden="true">
                &larr;
              </span>
              <span class="name">Writing</span>
            </a>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="dateline">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span class="updated"> · updated {fmt(updatedDate)}</span>}
        <span class="updated"> · {minutes} min read</span>
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((t) => (
              <li class="pill">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <p class="all-link"><a href="/writing">← All writing</a></p>
  </article>

  <style>
    .post-header {
      margin-bottom: clamp(2.5rem, 7vw, 3.5rem);
    }
    .kicker {
      font-size: 0.72rem;
      letter-spacing: 0.34em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-bottom: 1.25rem;
    }
    /* This was styled as a label and read as one — nothing said it was a way
       through to the project. Now: a "Part of" lead-in that names what the
       link does, the title in full ink with a rule under it, and an arrow that
       nudges on hover. */
    .kicker a {
      display: inline-flex;
      align-items: center;
      gap: 0.6em;
      color: var(--ink-soft);
      text-decoration: none;
    }
    .kicker .lead {
      opacity: 0.75;
    }
    .kicker .name {
      position: relative;
      color: var(--ink);
    }
    .kicker .name::after {
      content: '';
      position: absolute;
      left: 0;
      /* Uppercase tracking leaves a gap after the last glyph — pull the rule
         back by the same amount so it ends with the word. */
      right: 0.34em;
      bottom: -0.35em;
      height: 1px;
      background: currentColor;
      opacity: 0.4;
      transition: opacity 0.2s ease;
    }
    .kicker a:hover .name::after {
      opacity: 1;
    }
    .kicker .arrow {
      display: inline-block;
      transition: transform 0.2s ease;
    }
    .kicker a:hover .arrow {
      transform: translateX(3px);
    }
    .kicker a:hover .arrow.back {
      transform: translateX(-3px);
    }
    .post-header h1 {
      font-weight: 500;
      font-size: clamp(2.2rem, 7vw, 3.4rem);
      letter-spacing: 0.01em;
      line-height: 1.08;
    }
    .dateline {
      margin-top: 1rem;
      font-style: italic;
      font-size: clamp(1rem, 2.6vw, 1.1rem);
      color: var(--ink-soft);
    }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.1rem;
    }

    /* Carries the closing rule the prev/next nav used to draw, so the body
       still ends on a line rather than trailing off. */
    .all-link {
      margin-top: clamp(3rem, 8vw, 4.5rem);
      padding-top: 1.5rem;
      border-top: 1px solid var(--hair);
    }
    .all-link a {
      color: var(--ink-soft);
      text-decoration: none;
      font-size: 0.92rem;
      letter-spacing: 0.04em;
      transition: color 0.2s ease;
    }
    .all-link a:hover {
      color: var(--ink);
    }
  </style>
</Base>
