---
// Single blog-post layout. Sits on Base for all shared chrome and prose styling;
// adds the post header (title, dateline, reading time, tags) and the back
// links. The rendered Markdown body arrives through <slot />.
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  slug: string;
  minutes: number;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  slug,
  minutes,
} = Astro.props;

// Dates parse as UTC midnight; format in UTC so the build timezone can't
// shift them a day.
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '.');

const canonical = `https://blog.billwang.dev/${slug}`;
---

<Base
  title={`${title} — Bill Wang`}
  description={description}
  canonical={canonical}
  ogType="article"
  current="blog"
>
  <!-- Typesets the build-time KaTeX output in posts that use math. -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
  />

  <article>
    <header class="post-header">
      <p class="kicker"><a href="/blog"><span class="arrow" aria-hidden="true">&lt;──</span> ~/blog</a></p>
      <h1>{title}</h1>
      <p class="dateline">
        <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
        {updatedDate && <span> · updated {fmt(updatedDate)}</span>}
        <span> · {minutes} min read</span>
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <p class="all-link"><a href="/blog"><span class="arrow" aria-hidden="true">&lt;──</span> all posts</a></p>
  </article>

  <style>
    .post-header {
      margin: clamp(1rem, 4vw, 2rem) 0 clamp(2rem, 6vw, 3rem);
    }
    .kicker {
      font-size: 0.8rem;
      margin-bottom: 1.5rem;
    }
    .kicker a,
    .all-link a {
      color: var(--ink-soft);
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .kicker a:hover,
    .all-link a:hover {
      color: var(--ink);
    }
    .arrow {
      display: inline-block;
      transition: transform 0.2s ease;
    }
    a:hover .arrow {
      transform: translateX(-3px);
    }
    .post-header h1 {
      font-size: 1.2rem;
      font-weight: 600;
      line-height: 1.4;
    }
    .dateline {
      margin-top: 0.6rem;
      font-size: 0.75rem;
      color: var(--ink-soft);
    }
    .tags {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin-top: 0.4rem;
    }

    /* Closes the body on a rule rather than letting it trail off. */
    .all-link {
      margin-top: clamp(3rem, 8vw, 4.5rem);
      padding-top: 1.5rem;
      border-top: 1px solid var(--hair);
      font-size: 0.8rem;
    }
  </style>
</Base>
