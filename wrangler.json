{
  "name": "billwang-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EditorDO"] },
    { "tag": "v2", "deleted_classes": ["EditorDO"] }
  ],
  "vars": {
    "GITHUB_REPO": "billwang7599/billwang-site",
    "GITHUB_BRANCH": "main"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
